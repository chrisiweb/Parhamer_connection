\immediate\write-1{version 2025-10-31-14:45}


\NewConfigure{BackgroundMaterial}{2}%

\def\background:material{
  \a:BackgroundMaterial%
  \Background@Contents%
  \b:BackgroundMaterial%
}


% We must block the dafault command which is used in page hooks, as we will add the background in TeX4ht hooks
\def\:tempa{}
\HLet\bg@material\:tempa

% we now need to declare what will be inserted for particular pages
% this is reuse of code from background.sty, it set the default background
\ifbg@some
  \let\background:default\relax
\else
  \let\background:default\background:material
\fi

\let\background:thispage\background:default

% insert background at the begining of body of each page
\Configure{@BODY}{
  \background:thispage
  % reset to default for next page
  \global\let\background:thispage\background:default
}

% commands that will set background for the next page only
\def\:tempa{
  \let\background:thispage\background:material
}
\HLet\BgThispage\:tempa

\def\:tempa{
  \let\background:thispage\relax
}
\HLet\NoBgThispage\relax


\Hinput{background}
\endinput

